{
  "name": "whatsapp-sender",
  "version": "1.0.0",
  "private": true,
  "description": "Serviço local que conecta a um número dedicado de WhatsApp e envia follow-ups para grupos de clientes, consumindo uma fila no Redis compartilhado com o site corplaw-followup.",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@upstash/redis": "^1.34.3",
    "@whiskeysockets/baileys": "^6.7.9",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
